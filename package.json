{
  "name": "yokimind",
  "version": "1.2.0",
  "private": true,
  "description": "Yokimind - 把你的知识记录，做团队的企业大脑",
  "scripts": {
    "build": "pnpm -r build",
    "build:dist": "pnpm --filter @yokimind/web build:docker && pnpm --filter @yokimind/server build && node bin/build-dist.mjs",
    "build:pages": "pnpm --filter @yokimind/pages build",
    "dev:web": "pnpm --filter @yokimind/web dev",
    "dev:server": "pnpm --filter @yokimind/server dev",
    "dev:pages": "pnpm --filter @yokimind/pages dev",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:reset": "docker compose -f docker-compose.dev.yml down -v --remove-orphans",
    "docker:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:publish": "zx bin/docker-publish.mjs",
    "git:os:sync:dry": "zx bin/open-source/git-build.mjs --dry-run -v",
    "git:os:sync": "zx bin/open-source/git-build.mjs",
    "git:os:push": "zx bin/open-source/git-push.mjs",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "release": "zx bin/release.mjs",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "@release-it/bumper": "^8.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "prettier": "^3.9.5",
    "release-it": "^21.1.1",
    "typescript": "7.0.2",
    "zx": "^8.8.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "dayjs": "^1.11.23"
  }
}
