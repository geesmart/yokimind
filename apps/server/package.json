{
  "name": "@yokimind/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "vite build --mode prod",
    "build:tsc": "tsc",
    "start": "node dist/index.js",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "check:rpc": "tsx scripts/check-hono-rpc-types.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@hono/node-server": "^1.19.6",
    "@hono/zod-validator": "^0.7.6",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.1.40",
    "@langchain/openai": "^1.4.4",
    "@langchain/textsplitters": "^1.0.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "@tiptap/static-renderer": "3.31.3",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.11.9",
    "jose": "^5.2.0",
    "openai": "^7.10.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "postgres": "^3.4.7",
    "ulid": "^3.0.2",
    "uuid": "^13.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.9.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "@vitest/ui": "^4.0.18",
    "drizzle-kit": "^0.31.8",
    "prettier": "^3.8.1",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.18",
    "zx": "^8.8.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
