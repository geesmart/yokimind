# ============================================================
# Yoki 墨刻 · server 本地开发环境模板
# 用法：复制为 .env（同目录），按需修改；.env 已被 gitignore，不会提交
#   cp .env.example .env
#
# 依赖的基础设施容器由仓库根目录 docker-compose.dev.yml 一键提供：
#   PostgreSQL(6010) / Redis(6011) / RustFS(6012) / Qdrant(6333)
#   cd <仓库根目录> && docker compose -f docker-compose.dev.yml up -d
# ============================================================

# ---------- 应用 ----------
PORT=6001
NODE_ENV=development

# ---------- 主域名（对外地址唯一配置） ----------
# 本地统一入口（docker/Caddyfile.dev 路径路由）：/ →web、/api →server、/w /b →pages、/media →RustFS
# server 侧浏览器可达地址全部由它派生（图片基址 = ${PUBLIC_ORIGIN}/media/${S3_BUCKET}，见 core/lib/storage.ts）
PUBLIC_ORIGIN=http://yokimind.local:6000

# ---------- 其他对外/诊断地址：默认注释，由主域名覆盖，按需启用 ----------
# 诊断页展示地址（仅 views/index.view.ts 显示用；注释后回退 PUBLIC_ORIGIN）
#APP_URL=http://localhost:6002
# 历史遗留：全代码无消费
#API_URL=http://localhost:6002
# 图片对外基址显式覆盖（默认已从主域名派生）
#S3_PUBLIC_URL=http://yokimind.local:6000/media/yokimind-media

# 登录凭证签名密钥（本地开发可用默认值；生产环境务必设置随机长字符串）
#JWT_SECRET=change-me-in-production

# ---------- 数据库 ----------
# 与 docker-compose.dev.yml 的 postgres 服务对齐（宿主端口 6010）
DATABASE_URL=postgresql://root:123456@localhost:6010/yokimind_db

# ---------- 日志 ----------
LOG_LEVEL=info
# 要记录的请求 header（小写，逗号分隔，如 authorization,x-forwarded-for）
LOG_HEADERS=authorization
# 是否输出全部 SQL 语句（含参数值，调试用）
LOG_SQL=false

# ---------- RAG / 向量检索（Qdrant） ----------
# 与 docker-compose.dev.yml 的 qdrant 服务对齐
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=yokimind_rag
# Redis 连接（BullMQ 索引队列，db 2 与其他应用隔离）
REDIS_URL=redis://localhost:6011/2

# RAG 切片与检索参数
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=6
RAG_WORKER_INTERVAL_MS=10000

# ---------- 媒体对象存储（RustFS，S3 兼容） ----------
# 与 docker-compose.dev.yml 的 rustfs 服务对齐（宿主端口 6012）
# 浏览器可达的对外基址不在这里配：从请求头自动派生（见文件顶部与 core/lib/storage.ts）
S3_ENDPOINT=http://localhost:6012
S3_BUCKET=yokimind-media
S3_ACCESS_KEY=yokimind
S3_SECRET_KEY=yokimind-secret
