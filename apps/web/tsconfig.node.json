{
  // 继承根目录的 TypeScript 基础配置
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 使用 ES 模块
    "module": "ESNext",
    // Bundler 解析策略
    "moduleResolution": "Bundler",
    // 仅做类型检查，不输出文件
    "noEmit": true,
    // 包含 Node.js 内置模块类型
    "types": [
      "node"
    ],
    // 允许合成默认导入
    "allowSyntheticDefaultImports": true
  },
  // 仅包含 Node.js 环境下运行的配置文件，src/** 由 tsconfig.json 负责。
  // 注意：不设 include 时 tsc 默认卷入整个目录树（src 全量），
  // IDE 端 TS server 会因项目过大出现模块解析异常（找不到 vite 等）；
  // .js 配置（tailwind.config.js）无 allowJs 会被自动跳过，纯模式占位无副作用
  "include": ["vite.config.ts", "eslint.config.*", "tailwind.config.*", "postcss.config.*"]
}
