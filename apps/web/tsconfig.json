{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // web 是应用而非库，关闭声明文件生成，
    // 避免 pnpm 依赖隔离导致的 TS2742（推断类型无法命名，如 embla-carousel）
    "declaration": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "types": [
      "vite/client",
      "node"
    ],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    // 不设 rootDir：本包 noEmit + declaration:false，rootDir 仅在产出文件时有意义；
    // 保留反而会把 include 进来的根级配置文件（vite.config.ts）判成 TS6059
    // TS6 起 baseUrl 已废弃（TS7 移除）：paths 一律用 ./ 相对前缀，不再依赖 baseUrl
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.tsx",
    // 根级配置文件也纳入本配置（moduleResolution: bundler）：
    // 否则 IDE 端 WebStorm 对这种不在任何 include 里的文件会用默认 node10 解析，
    // 而 vite 8 类型只经 exports 暴露（顶层无 types 字段），node10 下报 TS2307
    "vite.config.ts"
  ]
}
