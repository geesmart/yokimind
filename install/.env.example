# YokiMind · 部署配置模板
#
# 用法：复制为 .env 放在 docker-compose.yml 同目录，只写需要修改的项（全部有默认值）
#   cp .env.example .env
# 推荐：./install.sh 一键安装——交互确认端口后自动生成 .env（凭据随机生成）并启动服务，
#       本模板供手工配置路径使用
#
# 原则：compose 内服务互联全部走容器网络（服务名:容器端口），对外只暴露 Caddy 一个 HTTP 入口。

# ---------- 入口（Caddy，对外唯一端口）----------
# 宿主入口端口，默认 60000（避开 80/443/808x 常见占用）。
# 需要 HTTPS 时在前置反代/云负载均衡做 TLS 终结，把 443 流量转发到此端口即可。
#HTTP_PORT=60000

# ---------- 应用 ----------
# 分享/预览令牌签名密钥（HMAC）：公网部署务必改成随机长字符串。
# 注意：登录态 token 存数据库与此无关；但默认值公开意味着任何人可伪造
# 分享密码令牌与预览令牌（绕过分享密码、构造长期预览链接）
#JWT_SECRET=change-me-to-a-long-random-string

# ---------- 数据库 / 存储 ----------
# PostgreSQL 密码（注意：仅首次建卷初始化时生效；已有数据后修改需进库改，容器 env 改了也不生效）
#POSTGRES_PASSWORD=yokimind

# RustFS（对象存储）访问凭据：同一值注入 rustfs 服务（启动凭据）
# 与 app 的 S3_ACCESS_KEY/S3_SECRET_KEY，保证两侧对齐。生产环境务必改默认值
#RUSTFS_ACCESS_KEY=yokimind
#RUSTFS_SECRET_KEY=yokimind-secret

# ---------- 外接 S3 兼容存储（可选，默认不设置用内置 RustFS）----------
# 已有 MinIO/云 S3 等对象存储时设置以下四项（凭据须成对），应用改为直连外部存储；
# 仅覆盖凭据不覆盖 endpoint 时无意义（endpoint 仍指向内置 rustfs，凭据须与之一致——
# 故改内置 rustfs 凭据请直接改上面的 RUSTFS_*，改一处即可双侧对齐）
#S3_ENDPOINT=http://your-s3-host:9000
#S3_BUCKET=yokimind-media
#S3_ACCESS_KEY=yokimind
#S3_SECRET_KEY=yokimind-secret

# ---------- 镜像 ----------
# 应用镜像地址：默认从 Docker Hub 拉取；离线导入/私有 registry 场景改成实际 tag
#YOKIMIND_IMAGE=geesmart/yokimind:latest
